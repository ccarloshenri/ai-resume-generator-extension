{
  "manifest_version": 3,
  "name": "AI Resume Generator",
  "version": "1.0.0",
  "description": "Analyze job postings and generate tailored resumes using AI",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Resume Generator"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/jobScanner.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"]
}
